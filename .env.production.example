# =============================================================================
# Production / Staging Environment Template
# =============================================================================
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS OR SECRETS.
# This file defines the required environment variables and placeholders for
# production and staging deployments of the auth-service.
# Every variable below must be supplied via secure secret management
# (e.g., Kubernetes Secrets, AWS Secrets Manager, Vault, or CI/CD pipeline).
# =============================================================================

NODE_ENV=production

# Server network binding. Use 0.0.0.0 inside containerized runtimes (Docker/K8s).
HOST=0.0.0.0
PORT=3001

# Public HTTPS canonical URL of the authentication service.
# MUST use https:// in production.
APP_BASE_URL=https://<REQUIRED_AUTH_DOMAIN_NAME_EXAMPLE_auth.arep.ai>

# Set to 'true' when deployed behind a TLS-terminating reverse proxy / ingress.
# When enabled, ingress must be configured to strip client-supplied X-Forwarded-For headers.
TRUST_PROXY=true

# Comma-separated list of trusted browser client origins.
# MUST use https:// and CANNOT include wildcard '*' or localhost/127.0.0.1.
CORS_ALLOWED_ORIGINS=https://<REQUIRED_WEB_APP_DOMAIN_EXAMPLE_app.arep.ai>,https://<REQUIRED_ADMIN_DOMAIN_EXAMPLE_admin.arep.ai>

# Database persistence (PostgreSQL).
# MUST be true in production (in-memory mode is strictly forbidden).
DATABASE_ENABLED=true
DATABASE_URL=postgresql://<REQUIRED_DB_USER>:<REQUIRED_DB_PASSWORD>@<REQUIRED_DB_HOST>:<REQUIRED_DB_PORT_DEFAULT_5432>/<REQUIRED_DB_NAME>?sslmode=require

# Distributed cache and token revocation (Redis).
# MUST be true in production (isolated memory cache is strictly forbidden in multi-instance setups).
REDIS_ENABLED=true
REDIS_HOST=<REQUIRED_REDIS_HOST>
REDIS_PORT=6379
REDIS_PASSWORD=<REQUIRED_REDIS_PASSWORD>

# Cryptographic HMAC secret for OTP challenge verification.
# MUST be a cryptographically random string of at least 32 characters (e.g. openssl rand -hex 32).
# Cannot use development defaults or dictionary words.
OTP_HMAC_SECRET=<REQUIRED_CRYPTOGRAPHIC_RANDOM_SECRET_MIN_32_CHARS>
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# JWT Access Token signing secret (HMAC-SHA256).
# MUST be a cryptographically random string of at least 32 characters (e.g. openssl rand -hex 32).
# Cannot use development defaults or dictionary words.
JWT_SECRET=<REQUIRED_CRYPTOGRAPHIC_RANDOM_SECRET_MIN_32_CHARS>
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=arep-auth-service
JWT_AUDIENCE=arep-api

# Session refresh token validity period (stored in HttpOnly cookie and database).
SESSION_REFRESH_TOKEN_TTL_DAYS=7

# SMTP Email delivery settings (for OTP email dispatch).
# When enabled, SMTP_AUTH_REQUIRED should be true with valid service credentials.
SMTP_ENABLED=true
SMTP_AUTH_REQUIRED=true
SMTP_HOST=<REQUIRED_SMTP_HOST_EXAMPLE_email-smtp.region.amazonaws.com>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=<REQUIRED_SMTP_USERNAME>
SMTP_PASSWORD=<REQUIRED_SMTP_PASSWORD>
SMTP_FROM=AREP Support <noreply@<REQUIRED_VERIFIED_EMAIL_DOMAIN>>
SMTP_TIMEOUT_MS=5000
