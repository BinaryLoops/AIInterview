{
  "name": "auth-service",
  "version": "0.0.0",
  "private": true,
  "description": "Authentication backend service",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch --noClear -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/test/**'",
    "test:integration": "vitest run src/test/auth-flow.integration.spec.ts",
    "test:postgres": "vitest run src/test/postgres-auth-flow.integration.spec.ts",
    "test:watch": "vitest",
    "config:validate": "node dist/config/validate-env.js",
    "prisma": "prisma"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/client": "5.15.0",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "^4.18.2",
    "jose": "^6.2.12",
    "nodemailer": "^6.10.0",
    "redis": "^4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@repo/config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "~24.19.2",
    "@types/nodemailer": "^6.4.17",
    "@types/redis": "^4.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.0",
    "vitest": "^5.0.3"
  }
}
