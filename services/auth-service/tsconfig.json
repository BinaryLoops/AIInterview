{
  "extends": "@repo/config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest", "express"]
  },
  "include": ["src/**/*.ts"]
}
