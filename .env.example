# Local development only. Copy this file to .env and keep .env untracked.
# These values are placeholders, not production secrets.

COMPOSE_PROJECT_NAME=ai-recruitment-ecosystem

POSTGRES_USER=arep
POSTGRES_PASSWORD=arep_dev_only
POSTGRES_DB=arep_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_PASSWORD=arep_redis_dev_only
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_HOST=127.0.0.1
MAILPIT_UI_PORT=8025

# auth-service local settings. Use HOST=0.0.0.0 inside containers.
# Database, Redis, and SMTP integrations are disabled until implemented.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_BASE_URL=http://127.0.0.1:3001
TRUST_PROXY=false
# Comma-separated trusted browser client origins.
# Required in production (must use https:// and cannot allow localhost/127.0.0.1).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_ENABLED=false
DATABASE_URL=postgresql://arep:arep_dev_only@127.0.0.1:5432/arep_dev
# Dedicated PostgreSQL test database for `pnpm test:postgres`.
# MUST NOT point to host port 5432 (reserved for unrelated system service).
# TEST_DATABASE_URL=postgresql://arep:arep_dev_only@127.0.0.1:5433/arep_test

REDIS_ENABLED=false

SMTP_ENABLED=false
SMTP_AUTH_REQUIRED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AREP <noreply@arep.local>
SMTP_TIMEOUT_MS=5000

# OTP settings (HMAC secret for verifier storage, 600s TTL, 5 max attempts)
OTP_HMAC_SECRET=dev_otp_hmac_secret_placeholder_at_least_32_characters_long
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# JWT Access Token settings (HMAC-SHA256, 900s / 15m TTL, explicit issuer & audience)
JWT_SECRET=dev_jwt_secret_placeholder_at_least_32_characters_long
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=arep-auth-service
JWT_AUDIENCE=arep-api

# Session refresh token validity period (stored in HttpOnly cookie and database)
SESSION_REFRESH_TOKEN_TTL_DAYS=7


